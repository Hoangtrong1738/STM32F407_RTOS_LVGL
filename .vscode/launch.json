{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F407 (ST-Link)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/blink_led.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "interface": "swd",
            "device": "STM32F407VE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "preLaunchTask": "Build",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/STM32F407.svd"
        },
        {
            "name": "Attach STM32F407 (ST-Link, no reflash)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/blink_led.elf",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "openocd",
            "interface": "swd",
            "device": "STM32F407VE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ]
        }
    ]
}