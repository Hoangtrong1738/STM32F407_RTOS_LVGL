{
    "version": 4,
    "configurations": [
        {
            "name": "STM32F407",
            "compilerPath": "C:/ST/STM32CubeCLT_1.19.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe",
            "intelliSenseMode": "gcc-arm",
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "includePath": [
                "${workspaceFolder}/Inc",
                "${workspaceFolder}/driver/inc",
                "${workspaceFolder}/driver/Mylib/Inc",
                "${workspaceFolder}/FreeRTOS-LTS/FreeRTOS/FreeRTOS-Kernel/include",
                "${workspaceFolder}/FreeRTOS-LTS/FreeRTOS/FreeRTOS-Kernel/portable/GCC/ARM_CM4F"
            ],
            "defines": [
                "STM32F407xx",
                "USE_HAL_DRIVER",
                "ARM_MATH_CM4"
            ],
            "compilerArgs": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-mfpu=fpv4-sp-d16",
                "-mfloat-abi=hard"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/Inc",
                    "${workspaceFolder}/Src",
                    "${workspaceFolder}/driver/inc",
                    "${workspaceFolder}/driver/scr",
                    "${workspaceFolder}/driver/Mylib/Inc",
                    "${workspaceFolder}/driver/Mylib/Src",
                    "${workspaceFolder}/FreeRTOS-LTS/FreeRTOS/FreeRTOS-Kernel/include",
                    "${workspaceFolder}/FreeRTOS-LTS/FreeRTOS/FreeRTOS-Kernel/portable/GCC/ARM_CM4F"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
